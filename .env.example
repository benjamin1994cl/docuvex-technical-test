# Valores ficticios para desarrollo local. Copiar a .env antes de levantar.
POSTGRES_USER=docuvex
POSTGRES_PASSWORD=cambiar_en_local
POSTGRES_DB=docuvex
DATABASE_URL=postgresql://docuvex:cambiar_en_local@db:5432/docuvex
DATASET_PATH=data/dataset.json
API_PORT=8000
LOG_LEVEL=INFO

# Extracción automática de entidades por reglas al cargar el dataset.
AUTO_EXTRACT=true

# Generador de respuestas: extractive (por defecto, sin LLM), llm-fake (simulado) o llm.
ANSWER_MODE=extractive
# Solo para ANSWER_MODE=llm. Dejar vacío en cualquier otro caso. Nunca subir una clave real.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
